# Server-only private planner configuration. Do not prefix with NEXT_PUBLIC_.
# Use the SAME isolated Neon development branch for database and auth.
DATABASE_URL=postgresql://APP_ROLE:PASSWORD@BRANCH-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://MIGRATION_ROLE:PASSWORD@BRANCH.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MEAL_PLANNER_OWNER_EMAIL=owner@example.com
APP_ORIGIN=http://localhost:3000

# Existing public-site CMS configuration, separate from Neon and Calendar OAuth.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_SECRET=
